# Repo di GitHub hanya perlu berisi yang dibutuhkan untuk build APK.
# Sisanya alat bantu di laptop, tidak ada gunanya diunggah.

# Script pembantu, hanya dipakai di Windows
*.bat

# Tampungan berkas yang menunggu dihapus manual
_to_delete/

# Catatan jalannya jalankan.bat, hanya berguna di laptop
jalankan_log.txt
crash_log.txt

# Data uji buatan alat/buat_dummy.py.
#
# Berkas .db bisa ratusan MB dan isinya nama karangan, tidak ada gunanya
# di GitHub. Scriptnya sendiri (alat/*.py) sengaja TIDAK diabaikan supaya
# ikut tersimpan, karena ukurannya kecil dan berguna diulang.
*.db
*.db-journal
*.db-wal
*.db-shm
dummy*.db

# Semua panduan digabung di README.md, dan README ikut diunggah
# karena itu satu-satunya dokumentasi.
*.md
!README.md

# Dibuat otomatis oleh Flutter saat build
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
build/
pubspec.lock
.metadata
*.log

# Kerangka platform dibuat ulang otomatis oleh GitHub Actions
android/
ios/
web/
linux/
macos/
windows/
test/

# Editor
.idea/
.vscode/
*.iml
*.swp
*~

# Sistem
.DS_Store
Thumbs.db
